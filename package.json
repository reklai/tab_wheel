{
  "name": "tabwheel",
  "version": "4.2.0",
  "private": true,
  "description": "Switch tabs with Alt + mouse wheel anywhere on the page. Fast, private, mouse-first tab control.",
  "license": "MIT",
  "scripts": {
    "build": "node esBuildConfig/build.mjs",
    "watch": "node esBuildConfig/build.mjs --watch",
    "lint": "node esBuildConfig/lint.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:compat": "node esBuildConfig/verifyCompat.mjs",
    "verify:upgrade": "node esBuildConfig/verifyUpgrade.mjs",
    "verify:store": "node esBuildConfig/verifyStore.mjs",
    "release:package": "node esBuildConfig/packageRelease.mjs",
    "ci": "npm run lint && npm run test && npm run typecheck && npm run verify:compat && npm run verify:upgrade && npm run verify:store && npm run build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
